rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public website visitors to submit enquiries
    match /enquiries/{document=**} {
      allow write: if true;
      allow read: if false;
    }

    // Allow logging of WhatsApp click requests
    match /whatsapp_requests/{document=**} {
      allow write: if true;
      allow read: if false;
    }
  }
}
